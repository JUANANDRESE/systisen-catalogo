# ============================================================
# CONFIGURACIÓN — CATÁLOGO SYSTISEN
# Copiá este archivo como .env y completá los valores reales
# ============================================================

PORT=3000

# --- Google Sheets (catálogo de productos) ---
# Hoja llamada "Productos" con columnas:
# Categoria | ID | Nombre | Descripcion | Precio | Emoji | Foto (URL) | Disponible (TRUE/FALSE)
# La cuenta de servicio debe tener acceso de Lector (o Editor) a la hoja.
GOOGLE_SERVICE_ACCOUNT_EMAIL=cuenta-servicio@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=

# --- WhatsApp del proveedor ---
# Número completo con código de país, solo dígitos (ej: 593991381117)
PROVEEDOR_WHATSAPP=

# --- Email del proveedor (opcional; si se omite, solo se genera el link de WhatsApp) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=ventas@systisen.com
